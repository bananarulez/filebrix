# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright output — regenerated by every `npm run test:e2e` run
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code per-machine settings (absolute local paths); the shared
# .claude/settings.json, if one is ever added, stays tracked
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# self-hosted DuckDB-WASM engine assets — derived copy of node_modules
# content, regenerated by the postinstall script (scripts/copy-duckdb-assets.mjs)
/public/duckdb/

# self-hosted pdf.js worker/cmaps/standard_fonts/wasm/iccs — derived copy of
# node_modules content, regenerated by scripts/copy-pdfjs-assets.mjs
/public/pdfjs/
/public/maplibre/

# self-hosted Material Icons webfont (jspreadsheet-ce's toolbar icons) —
# derived copy of node_modules content, regenerated by
# scripts/copy-material-icons-assets.mjs
/public/fonts/
src/engines/geospatial/ops/epsgIndex.generated.json
