# Required in production. Every canonical URL, OpenGraph/Twitter URL,
# sitemap.xml entry and robots.txt "Sitemap:" line is built from this value
# (see src/lib/seo/metadata.ts). It's read at build time, so it must be set
# before running `npm run build` for a production deploy — not just at
# runtime. If it's left unset, it silently falls back to
# "http://localhost:3000", and every one of those URLs will be wrong.
NEXT_PUBLIC_SITE_URL=https://example.com
