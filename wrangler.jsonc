{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filebrix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // Required by @opennextjs/cloudflare: the Next.js server it bundles uses
  // Node built-ins (node:path, node:buffer, ...) that workerd only exposes
  // behind this flag.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  /*
   * Why an R2 bucket exists at all on a site with no backend.
   *
   * Cloudflare caps an individual static asset at 25 MiB (Workers Free *and*
   * Paid — https://developers.cloudflare.com/workers/platform/limits/).
   * DuckDB-WASM's two engine binaries are 39.4 MB and 34.2 MB, so they are the
   * only two files in this project that cannot ship as static assets.
   *
   * They are served instead from this bucket through `app/duckdb/[file]/
   * route.ts`, on **the same origin** — deliberately not from an R2 public
   * bucket or an assets.* subdomain, either of which would be a cross-origin
   * request and would force `connect-src 'self'` in next.config.ts to be
   * loosened on the one site whose entire premise is that it never talks to
   * anywhere else. `tests/e2e/privacy.spec.ts` asserts zero off-origin
   * requests; that assertion stays true as written.
   *
   * The bucket holds no user data and never can — only our own copy of two
   * binaries that also exist in node_modules.
   */
  "r2_buckets": [
    {
      "binding": "ENGINE_ASSETS",
      "bucket_name": "filebrix-engine-assets"
    }
  ],

  "observability": {
    "enabled": true
  }
}
